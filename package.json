{
  "name": "codehub",
  "version": "0.1.8",
  "description": "CodeHub：信息学竞赛程序回收系统，可与 LemonServer 联动评测",
  "type": "module",
  "main": "server.js",
  "bin": {
    "codehub": "server.js"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node tests/smoke.mjs",
    "test:rename": "node --test tests/problem-rename.mjs",
    "test:materials": "node --test tests/material-release.mjs",
    "test:board": "node --test tests/board-sort.mjs",
    "test:ui": "node tests/login-layout.mjs"
  },
  "engines": {
    "node": ">=22.2"
  },
