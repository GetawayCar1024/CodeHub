[Unit]
Description=CodeHub - source code collection system for OI contests
Documentation=https://github.com/GetawayCar1024/CodeHub
After=network-online.target
Wants=network-online.target

[Service]
User=codehub
Group=codehub
WorkingDirectory=/var/lib/codehub
Environment=HOME=/var/lib/codehub
# Users, contests and submitted code live in /var/lib/codehub.
# To change the port, run `systemctl edit codehub` and override ExecStart.
ExecStart=/opt/codehub/bin/node /opt/codehub/server.js --host 0.0.0.0 --port 8088 --data /var/lib/codehub
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
